{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "type": {
                "type": "string",
                "title": "Entity Type"
            },
            "url": {
                "type": "string",
                "title": "Threads URL"
            },
            "id": {
                "type": "string",
                "title": "Post ID or Profile ID"
            },
            "username": {
                "type": "string",
                "title": "Username (@handle)"
            },
            "displayName": {
                "type": "string",
                "title": "Display Name"
            },
            "bio": {
                "type": "string",
                "title": "Bio / Description"
            },
            "followersCount": {
                "type": "string",
                "title": "Followers Count"
            },
            "followersCountRaw": {
                "type": "integer",
                "title": "Followers Raw Count"
            },
            "isVerified": {
                "type": "boolean",
                "title": "Verified Badge"
            },
            "profilePictureUrl": {
                "type": "string",
                "title": "Profile Picture URL"
            },
            "externalLink": {
                "type": "string",
                "title": "Bio External Link"
            },
            "postCode": {
                "type": "string",
                "title": "Post Shortcode"
            },
            "parentPostCode": {
                "type": "string",
                "title": "Parent Post Shortcode"
            },
            "text": {
                "type": "string",
                "title": "Post / Thread Text"
            },
            "likesCount": {
                "type": "integer",
                "title": "Likes Count"
            },
            "replyCount": {
                "type": "integer",
                "title": "Replies Count"
            },
            "repostCount": {
                "type": "integer",
                "title": "Reposts Count"
            },
            "quoteCount": {
                "type": "integer",
                "title": "Quotes Count"
            },
            "reshareCount": {
                "type": "integer",
                "title": "Reshares Count"
            },
            "mediaType": {
                "type": "string",
                "title": "Media Type (text, image, video, carousel)"
            },
            "imageUrls": {
                "type": "array",
                "title": "Images List",
                "items": { "type": "string" }
            },
            "videoUrl": {
                "type": "string",
                "title": "Direct MP4 Video Stream URL"
            },
            "replies": {
                "type": "array",
                "title": "Extracted Replies"
            },
            "replyText": {
                "type": "string",
                "title": "Reply Text"
            },
            "replyAuthor": {
                "type": "string",
                "title": "Reply Author"
            },
            "email": {
                "type": "string",
                "title": "Primary Contact Email"
            },
            "emails": {
                "type": "array",
                "title": "Extracted Emails",
                "items": { "type": "string" }
            },
            "phone": {
                "type": "string",
                "title": "Primary Contact Phone"
            },
            "phones": {
                "type": "array",
                "title": "Extracted Phones",
                "items": { "type": "string" }
            },
            "searchQuery": {
                "type": "string",
                "title": "Search Keyword"
            },
            "source": {
                "type": "string",
                "title": "Extraction Source Engine"
            },
            "publishedAt": {
                "type": "string",
                "title": "Published Timestamp"
            },
            "scrapedAt": {
                "type": "string",
                "title": "Scraped At Timestamp"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "type",
                    "username",
                    "displayName",
                    "text",
                    "likesCount",
                    "replyCount",
                    "repostCount",
                    "mediaType",
                    "url",
                    "publishedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "type": { "label": "Type", "format": "text" },
                    "username": { "label": "Username", "format": "text" },
                    "displayName": { "label": "Name", "format": "text" },
                    "text": { "label": "Text", "format": "text" },
                    "likesCount": { "label": "Likes", "format": "number" },
                    "replyCount": { "label": "Replies", "format": "number" },
                    "repostCount": { "label": "Reposts", "format": "number" },
                    "mediaType": { "label": "Media", "format": "text" },
                    "url": { "label": "URL", "format": "link" },
                    "publishedAt": { "label": "Published", "format": "date" }
                }
            }
        }
    }
}